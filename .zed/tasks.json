// See https://zed.dev/docs/tasks for documentation.
//
// Zed runs on the host; every task below executes inside the dev container with
// the Dev Containers CLI (npm i -g @devcontainers/cli). Run "Docker: Start" once
// per session.
[
  {
    "label": "[Nyar] Docker: Start",
    "command": "devcontainer up --workspace-folder . --config .devcontainer/devcontainer.json",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "reveal_target": "dock",
    "hide": "on_success",
    "shell": "system",
    "show_summary": true,
    "show_command": true,
    "save": "none",
  },
  {
    "label": "[Nyar] Docker: Stop",
    "command": "docker stop eldritch-codex-nyar",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "reveal_target": "dock",
    "hide": "on_success",
    "shell": "system",
    "show_summary": true,
    "show_command": true,
    "save": "none",
  },
  {
    "label": "[Nyar] Config Debug",
    "command": "devcontainer exec --workspace-folder . --config .devcontainer/devcontainer.json cmake -G Ninja -B build -S . -DCMAKE_CXX_COMPILER=clang++ -DCMAKE_BUILD_TYPE=Debug -DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "reveal_target": "dock",
    "hide": "never",
    "shell": "system",
    "show_summary": true,
    "show_command": true,
    "save": "none",
  },
  {
    "label": "[Nyar] Config Release",
    "command": "devcontainer exec --workspace-folder . --config .devcontainer/devcontainer.json cmake -G Ninja -B build -S . -DCMAKE_CXX_COMPILER=clang++ -DCMAKE_BUILD_TYPE=Release -DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "reveal_target": "dock",
    "hide": "never",
    "shell": "system",
    "show_summary": true,
    "show_command": true,
    "save": "none",
  },
  {
    "label": "[Nyar] Build",
    "command": "devcontainer exec --workspace-folder . --config .devcontainer/devcontainer.json cmake --build build -j4",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "reveal_target": "dock",
    "hide": "never",
    "shell": "system",
    "show_summary": true,
    "show_command": true,
    "save": "none",
  },
  {
    "label": "[Nyar] Build Clean",
    "command": "devcontainer exec --workspace-folder . --config .devcontainer/devcontainer.json cmake --build build --clean-first -j4",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "reveal_target": "dock",
    "hide": "never",
    "shell": "system",
    "show_summary": true,
    "show_command": true,
    "save": "none",
  },
  {
    "label": "[Nyar] Run Test App",
    "command": "devcontainer exec --workspace-folder . --config .devcontainer/devcontainer.json ./build/examples/nyar-test-app/nyar-test-app",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "reveal_target": "dock",
    "hide": "never",
    "shell": "system",
    "show_summary": true,
    "show_command": true,
    "save": "none",
  },
]
